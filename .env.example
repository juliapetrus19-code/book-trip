# BookTrip — environment variables (Vercel → Project → Settings → Environment Variables).
# Copy to .env for local use; never commit real values. docs/DEPLOY.md explains every step.

# --- Live mode (any book) --------------------------------------------------------------------
# Anthropic API key (console.anthropic.com → API Keys). Without it the site runs in demo mode.
ANTHROPIC_API_KEY=
# Optional: Claude model id. Default: claude-opus-5-5
ANTHROPIC_MODEL=
# Optional: reasoning effort for overview / characters / film: low | medium | high | xhigh | max.
# Default: medium (book search always uses low). Higher = slower and more expensive.
BOOK_EFFORT=

# --- Portraits and video ---------------------------------------------------------------------
# Google Gemini API key (aistudio.google.com → Get API key; billing must be enabled).
# Enables AI portraits of characters; together with PREMIUM_CODE also the premium video.
GEMINI_API_KEY=
# Optional: image model. Default: gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=
# Optional: video model. Default: veo-3.1-fast-generate-preview
GEMINI_VIDEO_MODEL=

# Secret code that unlocks the premium AI video (sent by the site in the x-premium-code header).
# Leave empty to switch video off completely. Change it to revoke access.
PREMIUM_CODE=

# --- Security --------------------------------------------------------------------------------
# Random secret (40+ characters) used to sign portrait/video prompts and video links.
# If empty, a hash of ANTHROPIC_API_KEY is used instead (rotating that key then invalidates links).
SIGNING_SECRET=

# =============================================================================================
# v2: accounts, "2 free books then subscription", shared AI cache. Everything below is optional:
# without these values the site works exactly as before (no paywall, in-memory store).
# docs/DEPLOY.md → "BookTrip v2" explains every step.

# --- Store: Upstash Redis (Vercel → Storage → Upstash Redis sets these automatically) ---------
# Without them an in-memory store is used (lost on every restart, not shared between servers).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# The same, under Upstash's own names (either pair works):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Sign-in by e-mail link -------------------------------------------------------------------
# SIGNING_SECRET (above) is REQUIRED for accounts: it seals the login cookies.
# Resend API key (resend.com → API Keys). Without it (and without AUTH_DEV_LINKS) sign-in is off.
RESEND_API_KEY=
# Sender, from a domain verified in Resend. Default: BookTrip <onboarding@resend.dev> (test only:
# Resend then delivers only to the owner's own address).
MAIL_FROM=
# DEV/TEST ONLY: 1 = /api/auth/start returns the login link instead of e-mailing it.
# NEVER set this in production — anyone could sign in as anyone.
AUTH_DEV_LINKS=

# --- Payments: Paddle Billing ---------------------------------------------------------------
# Billing (and with it the paywall) turns on when CLIENT_TOKEN + at least one PRICE + WEBHOOK_SECRET are set.
# sandbox (default) or production
PADDLE_ENV=sandbox
# Paddle → Developer tools → Authentication → API keys (server side, secret)
PADDLE_API_KEY=
# Paddle → Developer tools → Authentication → Client-side tokens (public, starts with test_ / live_)
PADDLE_CLIENT_TOKEN=
# Paddle → Catalog → Products → your product → Prices (pri_…)
PADDLE_PRICE_MONTH=
PADDLE_PRICE_YEAR=
# Paddle → Developer tools → Notifications → your destination → Secret key (pdl_ntfset_…)
PADDLE_WEBHOOK_SECRET=
# Prices as shown on the site (display only). Defaults: $4.99 and $29
PRICE_LABEL_MONTH=
PRICE_LABEL_YEAR=
# Free books per visitor before the paywall. Default: 2
FREE_BOOKS=

# --- Site ------------------------------------------------------------------------------------
# Telegram username for "write to us" buttons, without @ (e.g. booktrip_ua)
PUBLIC_TELEGRAM=
# Canonical address for e-mail links, sitemap and SEO tags, e.g. https://booktrip.com.ua
# Default: the address the request came to.
SITE_URL=
# Long random string; enables GET /api/admin (header x-admin-token). Empty = admin page off.
ADMIN_TOKEN=

# ---- Anime look (characters and film as drawn anime frames) ----
# Free: a Cloudflare account → Workers AI (10,000 "neurons" a day for free). Without these, visitors' browsers
# draw the pictures with Pollinations.ai (free, no key, slower). ANIME_PROVIDER=off → 3D only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Max pictures our server draws per day (protects the free allowance). Default 1500.
ANIME_DAILY_CAP=
ANIME_PROVIDER=
