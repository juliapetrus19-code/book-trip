# BookTrip — environment variables (Vercel → Project → Settings → Environment Variables).
# Copy to .env for local use; never commit real values. docs/DEPLOY.md explains every step.

# --- Live mode (any book) --------------------------------------------------------------------
# Anthropic API key (console.anthropic.com → API Keys). Without it the site runs in demo mode.
ANTHROPIC_API_KEY=
# Optional: Claude model id. Default: claude-opus-5-5
ANTHROPIC_MODEL=
# Optional: reasoning effort for overview / characters / film: low | medium | high | xhigh | max.
# Default: medium (book search always uses low). Higher = slower and more expensive.
BOOK_EFFORT=

# --- Portraits and video ---------------------------------------------------------------------
# Google Gemini API key (aistudio.google.com → Get API key; billing must be enabled).
# Enables AI portraits of characters; together with PREMIUM_CODE also the premium video.
GEMINI_API_KEY=
# Optional: image model. Default: gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=
# Optional: video model. Default: veo-3.1-fast-generate-preview
GEMINI_VIDEO_MODEL=

# Secret code that unlocks the premium AI video (sent by the site in the x-premium-code header).
# Leave empty to switch video off completely. Change it to revoke access.
PREMIUM_CODE=

# --- Security --------------------------------------------------------------------------------
# Random secret (40+ characters) used to sign portrait/video prompts and video links.
# If empty, a hash of ANTHROPIC_API_KEY is used instead (rotating that key then invalidates links).
SIGNING_SECRET=
